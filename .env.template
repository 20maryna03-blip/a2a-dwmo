# =============================================================================
# AI Platform Demo — Environment Variables Template
# Copy this file to .env and fill in your values
# =============================================================================

# --- LLM Backend (choose ONE) ---
#
# Option A: Ollama (recommended — runs 100% locally, no API key needed)
#   Install:  see README.md → Ollama Setup
#   Model:    llama3.2:1b is fast on CPU; qwen2.5:3b is higher quality
USE_OLLAMA=true
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:1b
#
# Option B: OpenAI (requires API key; blocked on some corporate networks)
# USE_OLLAMA=false
# OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.1

# --- HuggingFace Settings (optional — for embedding + multimodal tools) ---
# Get your free token at https://huggingface.co/settings/tokens
HF_API_KEY=hf_your_token_here
# Embedding model used by vector_mcp (runs locally, no HF token needed)
HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Text-generation model (HF Inference API — requires Pro plan for most LLMs)
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.1
# Multimodal / vision model for image analysis (optional)
HF_VISION_MODEL=Salesforce/blip-image-captioning-large

# --- Logging ---
LOG_LEVEL=INFO

# --- MCP Server URLs (used by agents to connect to MCP servers) ---
CUSTOM_MCP_URL=http://localhost:8004/mcp
TOOLBOX_MCP_URL=http://localhost:8005/mcp
VECTOR_MCP_URL=http://localhost:8006/mcp

# --- Agent URLs (used by orchestrator to call specialist agents) ---
RESEARCHER_AGENT_URL=http://localhost:8002
ANALYST_AGENT_URL=http://localhost:8003

# --- Agent public URLs (used in AgentCards; can differ behind a proxy) ---
ORCHESTRATOR_URL=http://localhost:8001
RESEARCHER_URL=http://localhost:8002
ANALYST_URL=http://localhost:8003

# --- Public API settings (no keys required) ---
ARXIV_API_URL=https://export.arxiv.org/api/query
OPENALEX_API_URL=https://api.openalex.org
OPENALEX_EMAIL=your@email.com
WIKIPEDIA_API_URL=https://en.wikipedia.org/api/rest_v1

# --- Vector DB (ChromaDB persistent storage) ---
VECTOR_DB_PATH=data/vector_db
