# =============================================================================
# AI Platform Demo — Environment Variables Template
# Copy this file to .env and fill in your values
# =============================================================================

# --- LLM Backend (choose ONE) ---
#
# Option A: HuggingFace Inference API (recommended — cloud, no local hardware needed)
#   Uses HF's OpenAI-compatible endpoint. Free tier available.
#   Requires a model that supports tool calling (function calling).
#   Free tier:  meta-llama/Llama-3.1-8B-Instruct
#   Pro tier:   meta-llama/Llama-3.3-70B-Instruct  or  Qwen/Qwen2.5-72B-Instruct
USE_HF_LLM=true
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
# HF OpenAI-compatible endpoint — change only if using a self-hosted TGI server
HF_BASE_URL=https://api-inference.huggingface.co/v1/
#
# Option B: Ollama (runs 100% locally, no API key; slow on CPU without GPU)
# USE_HF_LLM=false
# USE_OLLAMA=true
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2:1b
#
# Option C: OpenAI (requires API key; blocked on some corporate networks)
# USE_HF_LLM=false
# USE_OLLAMA=false
# OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.1
USE_OLLAMA=false

# --- HuggingFace Settings ---
# Get your free token at: https://huggingface.co/settings/tokens
# Required for: LLM backend (Option A) + multimodal tools (BLIP image, BART summary)
HF_API_KEY=hf_your_token_here
# Embedding model used by vector_mcp (runs locally, no GPU or HF token needed)
HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Multimodal / vision model for image analysis via Custom MCP (requires HF_API_KEY)
HF_VISION_MODEL=Salesforce/blip-image-captioning-large

# --- Logging ---
LOG_LEVEL=INFO

# --- MCP Server URLs (used by agents to connect to MCP servers) ---
CUSTOM_MCP_URL=http://localhost:8004/mcp
TOOLBOX_MCP_URL=http://localhost:8005/mcp
VECTOR_MCP_URL=http://localhost:8006/mcp

# --- Agent URLs (used by orchestrator to call specialist agents) ---
RESEARCHER_AGENT_URL=http://localhost:8002
ANALYST_AGENT_URL=http://localhost:8003

# --- Agent public URLs (used in AgentCards; can differ behind a proxy) ---
ORCHESTRATOR_URL=http://localhost:8001
RESEARCHER_URL=http://localhost:8002
ANALYST_URL=http://localhost:8003

# --- Public API settings (no keys required) ---
# NOTE: arXiv and OpenAlex are called directly by the MCP Toolbox binary via tools.yaml.
ARXIV_API_URL=https://export.arxiv.org/api/query
OPENALEX_API_URL=https://api.openalex.org
WIKIPEDIA_API_URL=https://en.wikipedia.org/api/rest_v1

# --- MCP Toolbox binary ---
# Path to the genai-toolbox binary (from googleapis/mcp-toolbox).
# Default: bin/toolbox in the project root (committed via Git LFS).
# Override if you want to use a different version.
# TOOLBOX_BIN=/path/to/toolbox
TOOLBOX_PORT=8005

# --- Vector DB (ChromaDB persistent storage) ---
VECTOR_DB_PATH=data/vector_db
